# 이 파일을 .env 로 복사해 값을 채운다. (.env 는 git 에 커밋되지 않는다)
# 데모 모드(DEMO_MODE=true)로만 띄울 거면 아래는 대부분 비워도 된다.

# --- LLM (코드 리뷰/리포트/번역) ---
# OpenAI 또는 OpenAI 호환 엔드포인트를 쓰는 제공자의 키
OPENAI_API_KEY=
# 미설정 시 리뷰·리포트는 gpt-4o, 번역은 gpt-4o-mini. 설정하면 양쪽 모두 이 값 사용
OPENAI_MODEL=
# 다른 제공자로 갈아끼울 때만 지정한다. 비우면 OpenAI 기본 엔드포인트.
#
# Gemini 무료 티어를 쓰려면 (키는 https://aistudio.google.com/apikey 에서 발급하되,
#  반드시 "새 프로젝트"로 만들 것 — 결제 계정이 붙은 기존 GCP 프로젝트를 고르면 유료로 전환된다):
#   OPENAI_API_KEY=<AI Studio 키>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=<무료 티어 Flash 모델. 사용 가능한 목록은 아래 명령으로 확인>
#     python -c "from openai import OpenAI; print([m.id for m in OpenAI(api_key='KEY', base_url='https://generativelanguage.googleapis.com/v1beta/openai/').models.list()])"
OPENAI_BASE_URL=
# 미설정 시 리뷰 2048 / 번역 2000
OPENAI_MAX_TOKENS=
OPENAI_REPORT_MAX_TOKENS=1024
# CF 문제 번역에만 쓰인다(cf_translator). 코드 리뷰·리포트는 temperature 를 넘기지 않는다.
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT=15
# 재시도는 타임아웃과 곱해져 실효 상한을 만든다(상한 = TIMEOUT × (1 + MAX_RETRIES)).
OPENAI_MAX_RETRIES=1

# --- GitHub OAuth (풀이 push 기능) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 서버 공개 URL (OAuth redirect 용, 예: https://myapp.run.app)
APP_URL=http://localhost:8080

# --- Codeforces (소스코드 가져오기용, 선택) ---
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=

# --- 데이터베이스 ---
# DATABASE_URL 을 직접 주면 아래 DB_* 를 모두 무시한다.
# DATABASE_URL=
# 로컬/데모는 기본값(SQLite) 그대로 두면 된다. 운영은 DB_TYPE=postgres.
DB_TYPE=sqlite
# SQLite 파일 경로 (미설정 시 프로젝트 루트 coding_recommend.db)
# DB_PATH=
# PostgreSQL 사용 시:
# DB_NAME=boj_review
# DB_USER=boj_user
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# Cloud SQL unix 소켓 (설정 시 DB_HOST/DB_PORT 대신 사용)
# DB_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE

# --- 기타 ---
# C++ 컴파일 타임아웃(초). 앱의 로컬 실행 경로와 실행 서비스가 함께 읽는다.
COMPILE_TIMEOUT=30

# 격리된 실행 전용 서비스(executor/)의 URL. 설정하면 /api/execute 는 직접 실행하지 않고
# 이 서비스로 위임한다. 운영이 쓰는 경로다 — 비워 두면 위임하지 않는다.
# EXECUTOR_URL=https://algo-executor-xxxxxxxx-du.a.run.app

# 위임 대상 없이 앱 프로세스 안에서 직접 실행하는 경로. 자식 프로세스는 앱과 같은
# uid·같은 네트워크 네임스페이스에서 돌기 때문에, 앱에 비밀이나 클라우드 권한이 붙어 있는
# 공개 배포에서는 켜면 안 된다 — 제출 코드가 메타데이터 서버(→ SA 토큰)와
# /proc/1/environ(→ 앱 환경변수 전체)에 도달한다. 실행 서비스를 띄우지 않는
# 로컬 개발에서만 true.
EXECUTE_ENABLED=true
# 허용 CORS 출처 (쉼표 구분)
CORS_ORIGINS=http://localhost:8080
# true 설정 시 mock 데이터로 동작 (API 키 불필요)
DEMO_MODE=false
